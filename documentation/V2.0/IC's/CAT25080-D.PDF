         <pdf:Producer>Acrobat Distiller 22.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">CAT25080 - CAT25080, CAT25160 - EEPROM Serial 8/16-Kb SPI</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The CAT25080/25160 are a EEPROM Serial 8/16âˆ’Kb SPI devices&#xA;internally organized as 1024x8/2048x8 bits. They feature a 32âˆ’byte&#xA;page write buffer and support the Serial Peripheral Interface (SPI)&#xA;protocol. The device is enabled through a Chip Select (CS) input. In&#xA;addition, the required bus signals are a clock input (SCK), data input&#xA;(SI) and data output (SO) lines. The HOLD input may be used to pause&#xA;any serial communication with the CAT25080/25160 device. These&#xA;devices feature software and hardware write protection, including&#xA;partial as well as full array protection.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:85715a31-f866-4af3-a42a-f84623e206ff</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:781fc32d-01d0-499f-809a-ab0d015d33b9</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                           
